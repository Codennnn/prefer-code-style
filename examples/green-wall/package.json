    "lint:css": "stylelint **/*.css",
    "lint:es": "eslint ./**/*.{ts,tsx}",
    "lint:ts": "tsc --noEmit --skipLibCheck",
    "start": "next start"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
