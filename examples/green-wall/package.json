    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "prefer-code-style": "workspace:*",
